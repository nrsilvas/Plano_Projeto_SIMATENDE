  document.getElementById('kpis').innerHTML=K.map(([l,k,d])=>{const done=data.filter(p=>p.st[k]>=100).length,av=Math.round(data.reduce((a,p)=>a+p.st[k],0)/n),pc=Math.round(done/n*100);
