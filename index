  document.getElementById('upd').textContent='Último status em '+fmtISO(state.ultStatus);
}
function autoAlerts(){const n=data.length,A=areas();
  const at=[];
  data.filter(p=>status(p)==='Em atraso').forEach(p=>at.push(`${p.p} (${p.a}): envio previsto para ${fmt(envio(p))} e estruturação em ${p.st[1]}%.`));
  const cob=A.get('Cobrança');if(cob)at.push(`Cobrança concentra ${cob.length} processos (${Math.round(cob.length/n*100)}% do escopo); exige capacidade dedicada nas Ondas 2 e 3.`);
  if(data.some(p=>/Agentes de IA/i.test(p.p)))at.push('Agentes de IA de Compras e Requisições depende de alinhamento com a Esteira de IA.');
  return at}
function fit(el){el.style.height='auto';el.style.height=el.scrollHeight+2+'px'}
const X='<span aria-hidden="true">×</span>';
const ta=(p,v,cls,ph,lab)=>`<textarea class="ed ${cls||''}" rows="1" data-p="${p}" placeholder="${ph}" aria-label="${lab}">${esc(v)}</textarea>`;
const del=(p,lab)=>`<button class="del" data-del="${p}" aria-label="Remover ${lab}" title="Remover">${X}</button>`;
function renderEditables(){
  document.getElementById('ultStatus').value=state.ultStatus||'';
  document.getElementById('ondasBox').innerHTML=state.ondas.map((o,i)=>`<div class="wave">
    <div class="wv-top">${ta(`ondas.${i}.t`,o.t,'h','Nome da onda','Nome da onda '+(i+1))}${del(`ondas.${i}`,'onda '+(i+1))}</div>
    ${ta(`ondas.${i}.w`,o.w,'m','Período','Período da onda '+(i+1))}
    <ul class="pp">${o.items.map((it,j)=>`<li><div class="row">${ta(`ondas.${i}.items.${j}`,it,'','Entrega ou processo','Item '+(j+1))}${del(`ondas.${i}.items.${j}`,'item')}</div></li>`).join('')}</ul>
    <button class="add" data-add="ondas.${i}.items">Adicionar item</button></div>`).join('')+
    `<button class="wave-new" data-add="ondas">Adicionar onda</button>`;
  document.getElementById('ritosBox').innerHTML=state.ritos.map((r,i)=>`<div class="panel">
    <div class="wv-top">${ta(`ritos.${i}.t`,r.t,'h','Nome do alinhamento','Nome do alinhamento '+(i+1))}${del(`ritos.${i}`,'alinhamento')}</div>
    ${ta(`ritos.${i}.s`,r.s,'m','Participantes · frequência','Participantes e frequência')}
    ${ta(`ritos.${i}.d`,r.d,'','Objetivo do alinhamento','Objetivo')}</div>`).join('')+
    `<button class="rit-new" data-add="ritos">Adicionar alinhamento</button>`;
  document.getElementById('atencao').innerHTML=state.atencao.map((a,i)=>`<li><div class="row">${ta(`atencao.${i}`,a,'','Descreva o ponto de atenção','Ponto de atenção '+(i+1))}${del(`atencao.${i}`,'ponto de atenção')}</div></li>`).join('');
  document.getElementById('passos').innerHTML=state.passos.map((s,i)=>`<li><div class="row">${ta(`passos.${i}.t`,s.t,'','Descreva o próximo passo','Próximo passo '+(i+1))}<input class="dt" type="date" data-p="passos.${i}.d" value="${esc(s.d)}" aria-label="Prazo do passo ${i+1}" title="Prazo">${del(`passos.${i}`,'passo')}</div></li>`).join('');
  fitAll();
}
function fitAll(){document.querySelectorAll('textarea.ed').forEach(fit)}
function resolve(path){const k=path.split('.');let o=state;for(let i=0;i<k.length-1;i++)o=o[k[i]];return[o,k[k.length-1]]}
const NEW={ondas:()=>({t:'Nova onda',w:'',items:['']}),ritos:()=>({t:'',s:'',d:''}),passos:()=>({t:'',d:''}),atencao:()=>''};
const chev='<svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>';
function renderAreas(){
  const q=document.getElementById('q').value.trim().toLowerCase(),fs=document.getElementById('fs').value;
  const box=document.getElementById('areas');let html='';
  for(const [a,idx] of areas()){
    const all=idx.map(i=>data[i]);
    const vis=idx.filter(i=>{const p=data[i];return(!q||(p.p+' '+p.focal+' '+p.resp).toLowerCase().includes(q))&&(!fs||status(p)===fs)});
    if((q||fs)&&!vis.length)continue;
    const n=all.length,cnt={};all.forEach(p=>{const s=status(p);cnt[s]=(cnt[s]||0)+1});
    const avg=Math.round(all.reduce((s,p)=>s+pct(p),0)/n);
    const seg=(k,c)=>cnt[k]?`<i style="width:${cnt[k]/n*100}%;background:${c}" title="${k}: ${cnt[k]}"></i>`:'';
    const mini=k=>{const av=Math.round(all.reduce((s,p)=>s+p.st[k],0)/n),d=all.filter(p=>p.st[k]>=100).length;
      return `<div class="mini" title="${STAGES[k]}: média ${av}%, ${d} de ${n} concluídos"><b>${av}%</b>${STAGES[k].split(' ')[0].replace('Teste/','')}<small>${d}/${n} concluídos</small></div>`};
    const open=openSet.has(a)||((q||fs)&&vis.length);
    html+=`<div class="area${open?' open':''}" data-a="${esc(a)}">
      <button class="area-h" aria-expanded="${open?'true':'false'}">${chev}
        <div class="nm">${esc(a)}<small>${n} processo${n>1?'s':''}</small></div>
        <div class="stackw"><div class="stack">${seg('Concluído','var(--ok)')}${seg('Em andamento','var(--wip)')}${seg('Em atraso','var(--late)')}</div>
          <div class="stack-l">${['Concluído','Em andamento','Em atraso','Não iniciado'].filter(k=>cnt[k]).map(k=>`${cnt[k]} ${k.toLowerCase()}`).join(', ')}</div></div>
        ${[0,1,2,3,4].map(mini).join('')}
        <div class="pct" title="Evolução ponderada da área">${avg}%</div></button>
      <div class="area-b"><div style="overflow-x:auto"><table class="proc"><thead><tr>
        <th>Processo</th><th>Ponto focal</th><th>Responsável</th><th>Início</th><th>SLA (d.u.)</th><th>Envio à área</th>
        ${STAGES.map(s=>`<th class="stg">${s}</th>`).join('')}<th>Integração</th><th>Workflow</th><th>% evolução</th><th>Status</th></tr></thead><tbody>
        ${vis.length?vis.map(i=>row(i)).join(''):'<tr><td colspan="15" class="empty">Nenhum processo com esse filtro.</td></tr>'}
      </tbody></table></div></div></div>`;
  }
  box.innerHTML=html||'<div class="panel empty">Nenhum processo encontrado. Ajuste a busca ou o filtro de status.</div>';
}
function row(i){const p=data[i],s=status(p),e=envio(p),pc=Math.round(pct(p));
  return `<tr data-i="${i}"><td class="pn">${esc(p.p)}</td>
  <td class="fo"><input data-f="focal" value="${esc(p.focal)}" placeholder="Definir" aria-label="Ponto focal"></td>
  <td class="fo"><input data-f="resp" value="${esc(p.resp)}" placeholder="Definir" aria-label="Responsável"></td>
  <td><input type="date" data-f="ini" value="${esc(p.ini)}" aria-label="Início"></td>
  <td><input type="number" min="0" data-f="sla" value="${esc(p.sla)}" aria-label="SLA"></td>
  <td class="env${s==='Em atraso'?' late':''}">${fmt(e)}</td>
  ${p.st.map((v,k)=>`<td class="stg"><div class="cell"><button class="chip" data-k="${k}" data-s="${lvl(v)}" title="${STAGES[k]}: ${v}% (clique para alternar)" aria-label="${STAGES[k]}: ${v}%">${SL[k]}</button><input type="number" min="0" max="100" step="5" data-k="${k}" value="${v}" aria-label="${STAGES[k]} em %"><span class="u">%</span></div></td>`).join('')}
  <td class="yn"><input data-f="integ" value="${esc(p.integ)}" placeholder="—" aria-label="Integração" style="width:56px"></td>
  <td class="yn"><input data-f="wf" value="${esc(p.wf)}" placeholder="—" aria-label="Workflow" style="width:56px"></td>
  <td><div class="pbar"><div class="t"><i style="width:${pc}%"></i></div><span>${pc}%</span></div></td>
  <td><span class="badge ${bcls[s]}">${s}</span></td></tr>`}
function refresh(){renderTop();renderAreas()}
function setStage(i,k,v,focusSel){data[i].st[k]=Math.max(0,Math.min(100,Math.round(v)||0));save();refresh();toast(`${STAGES[k]}: ${data[i].st[k]}%`);
  const nb=document.querySelector(`tr[data-i="${i}"] ${focusSel}[data-k="${k}"]`);nb&&nb.focus()}
const AR=document.getElementById('areas');
AR.addEventListener('click',ev=>{
  const h=ev.target.closest('.area-h');
  if(h){const a=h.parentElement.dataset.a;openSet.has(a)?openSet.delete(a):openSet.add(a);h.parentElement.classList.toggle('open');h.setAttribute('aria-expanded',h.parentElement.classList.contains('open'));return}
  const c=ev.target.closest('.chip');
  if(c){const i=+c.closest('tr').dataset.i,k=+c.dataset.k,v=data[i].st[k];setStage(i,k,v>=100?0:v>=50?100:50,'.chip')}
});
AR.addEventListener('change',ev=>{const inp=ev.target;const tr=inp.closest('tr');if(!tr)return;const i=+tr.dataset.i;
  if(inp.dataset.k!==undefined&&inp.type==='number'){setStage(i,+inp.dataset.k,+inp.value,'input');return}
  if(!inp.dataset.f)return;
  data[i][inp.dataset.f]=inp.dataset.f==='sla'?(inp.value?+inp.value:''):inp.value.trim();save();refresh();toast('Alteração salva')});
const AL=document.querySelector('main');
AL.addEventListener('input',ev=>{if(ev.target.matches('textarea.ed'))fit(ev.target)});
AL.addEventListener('change',ev=>{const p=ev.target.dataset.p;if(!p)return;const[o,k]=resolve(p);o[k]=ev.target.value.trim();save();toast('Alteração salva')});
AL.addEventListener('click',ev=>{
  const d=ev.target.closest('[data-del]');
  if(d){const p=d.dataset.del,[o,k]=resolve(p);const isCard=/^(ondas|ritos)\.\d+$/.test(p);
    if(isCard&&!confirm('Remover este card?'))return;o.splice(+k,1);save();renderEditables();toast('Item removido');return}
  const a=ev.target.closest('[data-add]');
  if(a){const p=a.dataset.add;const arr=p.split('.').reduce((o,k)=>o[k],state);const root=p.split('.')[0];
    arr.push(p.includes('.items')?'':NEW[root]());save();renderEditables();
    const sel=p.includes('.items')?`[data-p^="${p}."]`:`[data-p^="${p}.${arr.length-1}"]`;const l=document.querySelectorAll(sel);l.length&&l[l.length-1].focus()}
});
window.addEventListener('resize',fitAll);
document.getElementById('autoAt').onclick=()=>{const add=autoAlerts().filter(a=>!state.atencao.includes(a));if(!add.length){toast('Nenhum alerta novo no cronograma');return}state.atencao.push(...add);save();renderEditables();toast(add.length+' alerta(s) incluído(s)')};
document.getElementById('pdfBtn').onclick=exportPDF;
function exportPDF(){
  document.querySelectorAll('[data-p]').forEach(el=>{if(document.activeElement===el)el.blur()});
  const logo=document.querySelector('.logo').src;
  const pv=document.getElementById('printView');
  pv.innerHTML=`<div class="pv"><div class="pv-h"><img src="${logo}" alt="Martins"><div><h1>Alinhamentos e próximos passos</h1><p>Plano de trabalho: reformulação do SIM/Atende · Diretoria Geral de Eficiência Operacional</p><p>Último status em ${fmtISO(state.ultStatus)} · Evolução geral da frente: ${Math.round(data.reduce((a,p)=>a+pct(p),0)/data.length)}%</p></div></div>
  <h2>Alinhamentos</h2><div class="pv-rit">${state.ritos.filter(r=>r.t||r.d).map(r=>`<div><b>${esc(r.t)}</b><small>${esc(r.s)}</small>${esc(r.d)}</div>`).join('')}</div>
  <h2>Pontos de atenção</h2><ul>${state.atencao.filter(Boolean).map(a=>`<li>${esc(a)}</li>`).join('')||'<li>Sem pontos de atenção registrados.</li>'}</ul>
  <h2>Próximos passos</h2><table><thead><tr><th style="width:28px">#</th><th>Passo</th><th style="width:90px">Prazo</th></tr></thead><tbody>${state.passos.filter(s=>s.t).map((s,i)=>`<tr><td>${i+1}</td><td>${esc(s.t)}</td><td>${s.d?fmtISO(s.d):'—'}</td></tr>`).join('')}</tbody></table>
  <p class="foot">Gerado em ${new Date().toLocaleDateString('pt-BR')} a partir do painel do projeto.</p></div>`;
  const old=document.title;document.title='Alinhamentos e Proximos Passos - SIM-Atende';
  document.body.classList.add('printing');
  const done=()=>{document.body.classList.remove('printing');document.title=old;window.removeEventListener('afterprint',done)};
  window.addEventListener('afterprint',done);
  setTimeout(()=>{window.print();setTimeout(done,500)},50);
}
document.getElementById('ultStatus').addEventListener('change',ev=>{state.ultStatus=ev.target.value;save();renderTop();toast('Data do último status atualizada')});
document.getElementById('q').addEventListener('input',renderAreas);
document.getElementById('fs').addEventListener('change',renderAreas);
document.getElementById('expAll').onclick=()=>{areas().forEach((_,a)=>openSet.add(a));renderAreas()};
document.getElementById('colAll').onclick=()=>{openSet.clear();document.getElementById('q').value='';document.getElementById('fs').value='';renderAreas()};
document.getElementById('reset').onclick=()=>{if(!confirm('Substituir as alterações feitas neste navegador (cronograma, ondas, alinhamentos, próximos passos e data de status) pelos dados originais?'))return;state=clone(SEED_DATA);data=state.procs;fillDefaults();save();refresh();renderEditables();toast('Dados da planilha restaurados')};
document.getElementById('csv').onclick=()=>{
  const H=['Área','Processo','Ponto Focal','Responsável','Previsão de Início','SLA (dias úteis)','Previsão de Envio','Integração','Workflow',...STAGES.map(s=>s+' (%)'),'% Evolução','Status'];
  const L=[H].concat(data.map(p=>{const e=envio(p);return[p.a,p.p,p.focal,p.resp,p.ini,p.sla,e?e.toISOString().slice(0,10):'',p.integ,p.wf,...p.st,Math.round(pct(p)),status(p)]}));
  const csv='\ufeff'+L.map(r=>r.map(v=>`"${String(v??'').replace(/"/g,'""')}"`).join(';')).join('\r\n');
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));a.download='Cronograma_SIM-ATENDE_atualizado.csv';a.click();toast('CSV exportado')};
function setSide(min){document.body.classList.toggle('side-min',min);const b=document.getElementById('sideTg');b.setAttribute('aria-expanded',String(!min));b.querySelector('span').textContent=min?'Expandir menu':'Recolher menu';b.title=min?'Expandir menu':'Recolher menu';
  document.querySelectorAll('.side a').forEach(a=>{min?a.title=a.querySelector('span').textContent:a.removeAttribute('title')});
  try{localStorage.setItem('simatende_menu',min?'1':'0')}catch(e){}
  setTimeout(fitAll,220)}
document.getElementById('sideTg').onclick=()=>setSide(!document.body.classList.contains('side-min'));
const SECS=['escopo','indicadores','ondas','avanco','alinhamentos'];
function showSec(id,push){if(!SECS.includes(id))id='escopo';
  document.querySelectorAll('.content>section').forEach(s=>s.classList.toggle('active',s.id===id));
  document.querySelectorAll('.side a').forEach(a=>{a.dataset.sec===id?a.setAttribute('aria-current','page'):a.removeAttribute('aria-current')});
  const cur=document.querySelector('.side a[aria-current]');if(cur&&innerWidth<=900)cur.scrollIntoView({inline:'center',block:'nearest'});
  if(push)history.replaceState(null,'','#'+id);
  try{localStorage.setItem('simatende_secao',id)}catch(e){}
  if(id==='ondas'||id==='alinhamentos')requestAnimationFrame(fitAll);
  window.scrollTo({top:0})}
document.querySelector('.side').addEventListener('click',ev=>{const a=ev.target.closest('a[data-sec]');if(!a)return;ev.preventDefault();showSec(a.dataset.sec,true)});
window.addEventListener('hashchange',()=>showSec(location.hash.slice(1)));
load();fillDefaults();try{setSide(localStorage.getItem('simatende_menu')==='1')}catch(e){setSide(false)}openSet.add('Contas a Pagar');refresh();renderEditables();
(function(){let s=location.hash.slice(1);if(!SECS.includes(s)){try{s=localStorage.getItem('simatende_secao')}catch(e){}}showSec(s||'escopo',true)})();
</script>
